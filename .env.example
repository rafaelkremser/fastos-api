# Database
# Com Neon, `neon env pull` preenche as duas: DATABASE_URL (pool, usada pela API)
# e DATABASE_URL_UNPOOLED (conexão direta, usada pelas migrations).
# Com um Postgres local sem pool, as duas podem ter o mesmo valor.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/fastos_db?schema=public"
DATABASE_URL_UNPOOLED="postgresql://postgres:postgres@localhost:5432/fastos_db?schema=public"

# JWT (RS256 asymmetric keys, base64-encoded PEM)
# Gere um par novo com:  npm run gen:keys
# Depois cole a saída aqui substituindo as duas linhas abaixo.
JWT_PRIVATE_KEY=""
JWT_PUBLIC_KEY=""

# App
PORT=3333
