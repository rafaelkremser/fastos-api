# Database
# Com Neon, `neon env pull` preenche as duas: DATABASE_URL (pool, usada pela API)
# e DATABASE_URL_UNPOOLED (conexão direta, usada pelas migrations).
# Com um Postgres local sem pool, as duas podem ter o mesmo valor.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/fastos_db?schema=public"
DATABASE_URL_UNPOOLED="postgresql://postgres:postgres@localhost:5432/fastos_db?schema=public"

# JWT (RS256 asymmetric keys, base64-encoded PEM)
# Gere um par novo com:  npm run gen:keys
# Depois cole a saída aqui substituindo as duas linhas abaixo.
JWT_PRIVATE_KEY=""
JWT_PUBLIC_KEY=""

# App
PORT=3333

# Quantos proxies ficam na frente da API (balanceador, CDN). O limite de
# tentativas de login e cadastro é contado por IP do cliente; atrás de um
# proxy, com 0 todos os clientes dividem o IP do proxy e o mesmo limite.
# Use o número exato de proxies: um valor maior deixa o cliente falsificar o IP.
# Rodando local, sem proxy: 0.
TRUST_PROXY_HOPS=0

# Origens do frontend que podem chamar a API pelo navegador, separadas por
# vírgula. Cada origem é protocolo + domínio (+ porta), sem caminho nem barra
# no final. "*." libera um nível de subdomínio: cada loja tem o seu.
# Vazio: nenhum site consegue chamar a API pelo navegador.
# Produção, por exemplo: https://*.fastos.com
CORS_ORIGINS=http://localhost:5173,http://*.localhost:5173

# Documentação em /api/docs. Desligada se não for definida; deixe assim em
# produção, porque ela expõe o mapa da API.
SWAGGER_ENABLED=true
